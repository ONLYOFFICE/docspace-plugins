{
  "name": "email-viewer",
  "pluginName": "EmailViewer",
  "version": "1.0.0",
  "description": "Open .eml and .msg email files in DocSpace: headers, body and attachments, with saving attachments to the current folder",
  "author": "ONLYOFFICE",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ONLYOFFICE/docspace-plugins/tree/master/email-viewer",
  "private": true,
  "runtime": "module",
  "logo": "logo.svg",
  "nameLocale": {},
  "descriptionLocale": {
    "ru": "Открывает файлы .eml и .msg в DocSpace: заголовки, текст и вложения с сохранением вложений в текущую папку"
  },
  "scopes": [
    "File"
  ],
  "scripts": {
    "build": "vite build && npx build-docspace-plugin",
    "typecheck": "tsc --noEmit",
    "format": "npx prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@docspace/ui-kit": "file:./docspace-ui-kit-0.0.1.tgz",
    "@kenjiuno/msgreader": "^1.28.0",
    "@onlyoffice/docspace-plugin-sdk": "file:./onlyoffice-docspace-plugin-sdk-3.0.0.tgz",
    "buffer": "^6.0.3",
    "dompurify": "^3.4.15",
    "postal-mime": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
